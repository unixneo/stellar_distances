<%= turbo_frame_tag "results" do %>
  <!-- Main Result Card -->
  <div class="card result">
    <div class="card-title">📍 Journey to <%= @result[:star].name %></div>
    <p style="color: var(--text-muted); margin-top: -0.5rem; margin-bottom: 1rem;">
      Using <%= @result[:propulsion_system].name %>
    </p>
    
    <% if @result[:is_solar_system] && @result[:realistic_travel_days].present? %>
      <!-- SOLAR SYSTEM: Show realistic time prominently -->
      <div class="result-hero">
        <span class="result-value"><%= @result[:realistic_travel_human] %></span>
        <span class="result-unit">realistic mission duration</span>
      </div>
      
      <div class="disclaimer-box" style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 8px; padding: 1rem; margin: 1rem 0;">
        <strong style="color: #92400e;">🛰️ Why doesn't the rocket choice matter?</strong>
        <p style="color: #92400e; margin: 0.5rem 0 0 0; font-size: 0.9rem;">
          Within our solar system, <strong>orbital mechanics—not engine power—determines travel time.</strong>
          All chemical rockets (including Starship) use similar minimum-energy transfer orbits.
          A faster trajectory requires exponentially more fuel, which current technology can't carry.
        </p>
        <p style="color: #92400e; margin: 0.5rem 0 0 0; font-size: 0.9rem;">
          <em>Mission reference: <%= @result[:realistic_travel_notes] %></em>
        </p>
      </div>
      
      <div class="comparison-box" style="background: #f1f5f9; border-radius: 8px; padding: 1rem; margin: 1rem 0;">
        <strong>Straight-line calculation (for comparison): <%= @result[:travel_time_human] %></strong>
        <p style="color: var(--text-muted); margin: 0.5rem 0 0 0; font-size: 0.85rem;">
          This simplified calculation assumes constant velocity in a straight line, ignoring orbital mechanics.
          Real spacecraft follow curved trajectories and use gravity assists.
        </p>
      </div>
    <% else %>
      <!-- INTERSTELLAR or no realistic data: Show calculated time -->
      <div class="result-hero">
        <span class="result-value"><%= @result[:travel_time_human] %></span>
        <span class="result-unit">one-way travel time</span>
      </div>
      
      <% if @result[:is_solar_system] %>
        <!-- Solar system object without realistic data (Oort Cloud) -->
        <div class="disclaimer-box" style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 8px; padding: 1rem; margin: 1rem 0;">
          <strong style="color: #92400e;">⚠️ Estimated only:</strong>
          <p style="color: #92400e; margin: 0.5rem 0 0 0; font-size: 0.9rem;">
            <% if @result[:star].realistic_travel_notes.present? %>
              <%= @result[:star].realistic_travel_notes %>
            <% else %>
              No spacecraft has traveled to this destination. Time shown is a straight-line estimate.
            <% end %>
          </p>
        </div>
      <% end %>
    <% end %>
    
    <div class="result-grid">
      <div class="result-item">
        <div class="result-item-label">Distance</div>
        <div class="result-item-value">
          <% if @result[:is_solar_system] %>
            <%= @result[:star].formatted_distance %>
          <% else %>
            <%= number_with_delimiter(@result[:distance_ly].round(2)) %> ly
          <% end %>
        </div>
      </div>
      
      <div class="result-item">
        <div class="result-item-label">Velocity</div>
        <div class="result-item-value">
          <% if @result[:velocity_fraction_c] >= 0.01 %>
            <%= (@result[:velocity_fraction_c] * 100).round(2) %>% c
          <% else %>
            <%= number_with_delimiter(@result[:velocity_km_s].round(1)) %> km/s
          <% end %>
        </div>
      </div>
      
      <div class="result-item">
        <div class="result-item-label">Generations</div>
        <div class="result-item-value"><%= number_with_delimiter(@result[:generations]) %></div>
      </div>

      <div class="result-item">
        <div class="result-item-label">Earth Frame Time</div>
        <div class="result-item-value"><%= @result[:travel_time_human] %></div>
      </div>

      <div class="result-item">
        <div class="result-item-label">Crew Proper Time</div>
        <div class="result-item-value"><%= @result[:crew_time_human] %></div>
      </div>

      <div class="result-item">
        <div class="result-item-label">Lorentz Gamma (γ)</div>
        <div class="result-item-value"><%= @result[:time_dilation_gamma].round(4) %></div>
      </div>

      <div class="result-item">
        <div class="result-item-label">Causality Floor (v→c)</div>
        <div class="result-item-value"><%= @result[:minimum_possible_travel_human] %></div>
      </div>
    </div>
  </div>

  <!-- Scientific Methodology -->
  <div class="card">
    <div class="card-title">📐 Calculation Method</div>
    <p><%= @result[:calculation_disclaimer] %></p>
  </div>

  <!-- Communication Delay -->
  <div class="card">
    <div class="card-title">📡 Communication Reality</div>
    <div class="comm-grid">
      <div>
        <strong>Message travel time (one way):</strong><br>
        <span style="font-size: 1.25rem; color: var(--primary);">
          <% delay_seconds = @result[:communication_delay_years] * 31_557_600 %>
          <% if delay_seconds < 60 %>
            <%= delay_seconds.round(1) %> seconds
          <% elsif delay_seconds < 3600 %>
            <%= (delay_seconds / 60.0).round(1) %> minutes
          <% elsif delay_seconds < 86400 %>
            <%= (delay_seconds / 3600.0).round(1) %> hours
          <% elsif @result[:communication_delay_years] < 1 %>
            <%= (@result[:communication_delay_years] * 365.25).round(1) %> days
          <% else %>
            <%= number_with_delimiter(@result[:communication_delay_years].round(1)) %> years
          <% end %>
        </span>
      </div>
      <div>
        <strong>Round-trip communication:</strong><br>
        <span style="font-size: 1.25rem; color: var(--primary);">
          <% rt_seconds = @result[:round_trip_communication_years] * 31_557_600 %>
          <% if rt_seconds < 60 %>
            <%= rt_seconds.round(1) %> seconds
          <% elsif rt_seconds < 3600 %>
            <%= (rt_seconds / 60.0).round(1) %> minutes
          <% elsif rt_seconds < 86400 %>
            <%= (rt_seconds / 3600.0).round(1) %> hours
          <% elsif @result[:round_trip_communication_years] < 1 %>
            <%= (@result[:round_trip_communication_years] * 365.25).round(1) %> days
          <% else %>
            <%= number_with_delimiter(@result[:round_trip_communication_years].round(1)) %> years
          <% end %>
        </span>
      </div>
    </div>
    <p class="hint" style="margin-top: 0.75rem; font-size: 0.85rem; color: var(--text-muted);">
      Light-speed communication is a hard physical limit. Nothing—no signal, no information—can travel faster.
    </p>
    <p class="hint" style="margin-top: 0.5rem;">
      At this cruise speed, departure-phase signals are redshifted to
      <strong><%= (@result[:doppler_departure_redshift_factor] * 100).round(2) %>%</strong> of emitted frequency.
      If the craft is inbound, received frequency is blueshifted by
      <strong><%= @result[:doppler_arrival_blueshift_factor].round(3) %>×</strong>.
    </p>
  </div>

  <!-- Energy Requirements -->
  <div class="card">
    <div class="card-title">⚡ Energy Requirements</div>
    <p style="color: var(--text-muted);">
      To accelerate <%= number_with_delimiter(@result[:payload_mass_kg].round(0)) %> kg to
      <%= @result[:propulsion_system].formatted_velocity %>:
    </p>
    <div class="energy-grid">
      <div class="energy-item">
        <div class="energy-value"><%= number_with_delimiter(@result[:energy_in_hiroshima_bombs].round(1)) %></div>
        <div class="energy-label">15 kt TNT equivalents</div>
      </div>
      <div class="energy-item">
        <div class="energy-value">
          <% if @result[:energy_in_world_years] < 0.001 %>
            <%= (@result[:energy_in_world_years] * 365.25).round(2) %> days
          <% elsif @result[:energy_in_world_years] < 1 %>
            <%= (@result[:energy_in_world_years] * 12).round(1) %> months
          <% else %>
            <%= number_with_delimiter(@result[:energy_in_world_years].round(1)) %> years
          <% end %>
        </div>
        <div class="energy-label">of total world energy production</div>
      </div>
    </div>
    <p class="hint">
      Relativistic KE is used: <strong>KE = (γ-1)mc²</strong>. This is just acceleration energy and excludes
      deceleration, life support, and propulsion inefficiencies.
    </p>
  </div>

  <!-- Interstellar Medium Constraint -->
  <% unless @result[:is_solar_system] %>
  <div class="card">
    <div class="card-title">🧱 Interstellar Medium Constraint</div>
    <p class="hint" style="margin-bottom: 0.75rem;">
      These values assume average ISM density of ~1 hydrogen atom/cm³. At relativistic speed, those atoms are high-energy impacts in the ship frame.
    </p>
    <div class="result-grid">
      <div class="result-item">
        <div class="result-item-label">Hydrogen Density</div>
        <div class="result-item-value">~1 atom/cm³</div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Impact Flux</div>
        <div class="result-item-value"><%= @result[:ism_atom_flux_cm2_s_human] %></div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Energy Per Proton</div>
        <div class="result-item-value"><%= @result[:ism_proton_energy_human] %></div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Energy Load</div>
        <div class="result-item-value"><%= @result[:ism_power_load_w_m2_human] %></div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Total Hits Over Journey</div>
        <div class="result-item-value"><%= @result[:ism_total_hits_m2_human] %></div>
      </div>
    </div>
    <p class="hint">
      This is a major engineering limit for high-speed massive craft: shielding, sputtering, secondary radiation, and heat management become mission-critical.
    </p>
  </div>
  <% end %>

  <!-- Relativity Explorer -->
  <% unless @result[:is_solar_system] %>
  <div
    class="card"
    data-controller="relativity-slider"
    data-relativity-slider-distance-ly-value="<%= @result[:distance_ly] %>"
    data-relativity-slider-payload-mass-kg-value="<%= @result[:payload_mass_kg] %>"
    data-relativity-slider-exhaust-velocity-km-s-value="<%= @result[:exhaust_velocity_km_s] || 0 %>"
    data-relativity-slider-initial-beta-value="<%= @result[:velocity_fraction_c] %>"
    data-relativity-slider-propellantless-value="<%= @result[:propellantless] %>"
  >
    <div class="card-title">🎚️ Velocity Explorer (Relativistic)</div>
    <p class="hint">
      Propulsion model: <strong><%= @result[:propulsion_system].name %></strong>
      <% unless @result[:propellantless] %>
        (exhaust velocity <%= @result[:exhaust_velocity_km_s] %> km/s)
      <% end %>
    </p>
    <p class="hint" style="margin-bottom: 0.75rem;">
      Slide velocity toward <em>c</em> to see how energy, fuel, and time dilation co-evolve.
    </p>

    <div class="slider-box">
      <label for="velocity-slider">Cruise velocity</label>
      <input
        id="velocity-slider"
        type="range"
        min="0.001"
        max="0.99"
        step="0.001"
        data-relativity-slider-target="slider"
        data-action="input->relativity-slider#update"
      >
      <div class="slider-readout">
        <span data-relativity-slider-target="velocityPercent"><%= (@result[:velocity_fraction_c] * 100).round(2) %>% c</span>
        <span data-relativity-slider-target="velocityKmS"><%= number_with_delimiter(@result[:velocity_km_s].round(0)) %> km/s</span>
      </div>
    </div>

    <div class="result-grid" style="margin-top: 1rem;">
      <div class="result-item">
        <div class="result-item-label">Earth Time</div>
        <div class="result-item-value" data-relativity-slider-target="earthTime"><%= @result[:travel_time_human] %></div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Crew Time</div>
        <div class="result-item-value" data-relativity-slider-target="crewTime"><%= @result[:crew_time_human] %></div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Gamma (γ)</div>
        <div class="result-item-value" data-relativity-slider-target="gamma"><%= @result[:time_dilation_gamma].round(4) %></div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Causality Floor (v→c)</div>
        <div class="result-item-value" data-relativity-slider-target="causalityFloor"><%= @result[:minimum_possible_travel_human] %></div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Energy</div>
        <div class="result-item-value" data-relativity-slider-target="energyWorld"><%= number_with_delimiter(@result[:energy_in_world_years].round(2)) %> years</div>
      </div>
      <div class="result-item">
        <div class="result-item-label">15 kt TNT Eq.</div>
        <div class="result-item-value" data-relativity-slider-target="energyBombs"><%= number_with_delimiter(@result[:energy_in_hiroshima_bombs].round(2)) %> eq</div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Mass Ratio (1-way)</div>
        <div class="result-item-value" data-relativity-slider-target="massRatio"><%= @result[:mass_ratio_one_way] ? "#{number_with_delimiter(@result[:mass_ratio_one_way].round(2))}:1" : "N/A" %></div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Fuel Mass (1-way)</div>
        <div class="result-item-value" data-relativity-slider-target="fuelMass"><%= @result[:fuel_mass_one_way_human] || "No onboard propellant" %></div>
      </div>
    </div>

    <div class="curve-box">
      <div class="curve-title">Energy vs Velocity (log scale)</div>
      <svg viewBox="0 0 640 240" preserveAspectRatio="none" data-relativity-slider-target="curve"></svg>
    </div>

    <script>
      (() => {
        const widget = document.currentScript.closest("[data-controller~='relativity-slider']");
        if (!widget) return;
        const slider = widget.querySelector("[data-relativity-slider-target='slider']");
        if (!slider || slider.dataset.inlineInit === "true") return;
        slider.dataset.inlineInit = "true";

        const cKmS = 299792.458;
        const cMS = 299792458;
        const worldJ = 5.8e20;
        const hiroshimaJ = 63e12;
        const distanceLy = parseFloat(widget.dataset.relativitySliderDistanceLyValue || "0");
        const payloadKg = parseFloat(widget.dataset.relativitySliderPayloadMassKgValue || "1000");
        const veKmS = parseFloat(widget.dataset.relativitySliderExhaustVelocityKmSValue || "0");
        const propellantless = widget.dataset.relativitySliderPropellantlessValue === "true";

        const fmt = (n, d=2) => Number(n).toLocaleString(undefined, { maximumFractionDigits: d });
        const sci = (n, sig=3) => {
          if (!Number.isFinite(n)) return "∞";
          const a = Math.abs(n);
          if (a === 0) return "0";
          if (a >= 1e6 || a < 1e-3) {
            const exp = Math.floor(Math.log10(a));
            const coeff = n / (10 ** exp);
            return `${coeff.toFixed(Math.max(0, sig - 1))}e${exp >= 0 ? "+" : ""}${exp}`;
          }
          return fmt(n, 2);
        };
        const set = (k, v) => { const el = widget.querySelector(`[data-relativity-slider-target='${k}']`); if (el) el.textContent = v; };
        const years = (y) => y >= 1000 ? `${fmt(y,0)} years` : `${fmt(y,1)} years`;

        const update = () => {
          const beta = Math.min(0.999999, Math.max(0.000001, parseFloat(slider.value || "0.001")));
          const gamma = 1 / Math.sqrt(1 - beta * beta);
          const vKmS = beta * cKmS;
          const earthYears = distanceLy / beta;
          const crewYears = earthYears / gamma;
          const kJ = (gamma - 1) * payloadKg * cMS * cMS;
          const worldYears = kJ / worldJ;
          const bombs = kJ / hiroshimaJ;

          set("velocityPercent", `${fmt(beta * 100, 2)}% c`);
          set("velocityKmS", `${fmt(vKmS, 0)} km/s`);
          set("gamma", fmt(gamma, 4));
          set("earthTime", years(earthYears));
          set("crewTime", years(crewYears));
          set("causalityFloor", years(distanceLy));
          set("energyWorld", `${sci(worldYears, 3)} years`);
          set("energyBombs", `${sci(bombs, 3)} eq`);

          if (propellantless || veKmS <= 0) {
            set("massRatio", "N/A");
            set("fuelMass", "No onboard propellant");
          } else {
            const ratio = Math.exp(Math.atanh(beta) / (veKmS / cKmS));
            const fuelKg = payloadKg * (ratio - 1);
            set("massRatio", Number.isFinite(ratio) ? `${sci(ratio, 3)}:1` : "∞");
            set("fuelMass", Number.isFinite(fuelKg) ? `${sci(fuelKg, 3)} kg` : "Incalculably large");
          }
        };

        slider.addEventListener("input", update);
        update();
      })();
    </script>
  </div>
  <% end %>

  <!-- Fuel Requirements (Delta-V) -->
  <% unless @result[:is_solar_system] %>
  <div class="card">
    <div class="card-title">🚀 Fuel Requirements (Relativistic Rocket Equation)</div>
    <p class="hint">
      Active propulsion system: <strong><%= @result[:propulsion_system].name %></strong>
    </p>

    <% if @result[:propellantless] %>
      <div class="disclaimer-box" style="background: #f0fdf4; border: 1px solid #86efac; border-radius: 8px; padding: 1rem; margin: 1rem 0;">
        <strong style="color: #166534;">No propellant required.</strong>
        <p style="color: #166534; margin: 0.5rem 0 0 0; font-size: 0.9rem;">
          <%= @result[:propellantless_reason] %>
        </p>
        <p style="color: #166534; margin: 0.5rem 0 0 0; font-size: 0.9rem;">
          The relativistic rocket equation does not apply —
          this system is not a rocket.
        </p>
      </div>
    <% else %>
      <p style="color: var(--text-muted);">
        To carry <%= number_with_delimiter(@result[:payload_mass_kg].round(0)) %> kg
        using <%= @result[:propulsion_system].name %> (exhaust velocity <%= @result[:exhaust_velocity_km_s] %> km/s):
      </p>

      <table style="width:100%; border-collapse: collapse; margin: 1rem 0;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border-color);">
            <th style="text-align: left; padding: 0.5rem 0;">Scenario</th>
            <th style="text-align: right; padding: 0.5rem 0;">Mass Ratio</th>
            <th style="text-align: right; padding: 0.5rem 0;">Fuel Mass Needed</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.5rem 0;">Accelerate only (one-way coast)</td>
            <td style="text-align: right;"><%= number_with_delimiter(@result[:mass_ratio_one_way].round(1)) %>:1</td>
            <td style="text-align: right;"><%= @result[:fuel_mass_one_way_human] %></td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.5rem 0;">Accelerate + Decelerate (stop at destination)</td>
            <td style="text-align: right;"><%= number_with_delimiter(@result[:mass_ratio_with_decel].round(1)) %>:1</td>
            <td style="text-align: right;"><%= @result[:fuel_mass_with_decel_human] %></td>
          </tr>
          <tr>
            <td style="padding: 0.5rem 0;">Full Round Trip</td>
            <td style="text-align: right;"><%= number_with_delimiter(@result[:mass_ratio_round_trip].round(1)) %>:1</td>
            <td style="text-align: right;"><%= @result[:fuel_mass_round_trip_human] %></td>
          </tr>
        </tbody>
      </table>

      <p class="hint">
        The mass ratio is how many kg of fuel you need per kg of final payload.
        A ratio of 10:1 means 9 kg of fuel for every 1 kg of payload.
        Deceleration requires the same Δv as acceleration — squaring the ratio.
        Round trip compounds this to the 4th power.
      </p>

      <p style="font-size: 0.9rem; color: var(--text-muted);">
        <strong>atanh(v/c) = (Vₑ/c) × ln(m₀/mf)</strong> —
        Exhaust velocity: <%= @result[:exhaust_velocity_km_s] %> km/s |
        Δv needed: <%= @result[:velocity_km_s] %> km/s
      </p>

      <p class="hint" style="border-top: 1px solid var(--border-color); padding-top: 0.75rem; margin-top: 0.75rem;">
        <strong>Model simplifications:</strong> This uses four impulsive burns at cruise velocity
        (accelerate from Earth, decelerate at destination, accelerate back, decelerate at Earth).
        A physically complete mission profile would integrate thrust continuously over acceleration phases.
        It excludes: Earth's gravity well on departure (~11.2 km/s escape velocity),
        the destination body's gravity well (5–15 km/s depending on planet), and
        aerobraking on Earth return (which eliminates burn #4 in practice).
        Actual fuel requirements for landing-and-returning missions would be higher.
      </p>
    <% end %>
  </div>
  <% end %>

  <!-- Feasibility Assessment -->
  <div class="card">
    <div class="card-title">
      🎯 Feasibility: 
      <span class="feasibility-<%= @result[:feasibility_assessment][:level] %>">
        <%= @result[:feasibility_assessment][:level].to_s.titleize %>
      </span>
    </div>
    <p><%= @result[:feasibility_assessment][:description] %></p>
  </div>

  <!-- Reality Checks -->
  <% if @result[:reality_check].any? %>
    <div class="reality-checks">
      <div class="reality-checks-title">⚠️ Reality Checks</div>
      <ul>
        <% @result[:reality_check].each do |check| %>
          <li><%= check %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Star Info -->
  <div class="card">
    <div class="card-title">
      <% if @result[:is_solar_system] %>
        🪐 About <%= @result[:star].name %>
      <% else %>
        ⭐ About <%= @result[:star].name %>
      <% end %>
    </div>
    <div class="info-section">
      <p><strong>Type:</strong> <%= @result[:star].star_type %></p>
      <% unless @result[:is_solar_system] %>
        <p><strong>Constellation:</strong> <%= @result[:star].constellation %></p>
      <% end %>
      <p><strong>Notes:</strong> <%= @result[:star].notes %></p>
    </div>
  </div>

  <!-- Propulsion Info -->
  <div class="card">
    <div class="card-title">🔧 About <%= @result[:propulsion_system].name %></div>
    <div class="info-section">
      <p><strong>Technology Status:</strong> <%= @result[:propulsion_system].technology_readiness %></p>
      <p><strong>Description:</strong> <%= @result[:propulsion_system].description %></p>
    </div>
  </div>

  <!-- Back to Top -->
  <div style="text-align: center; margin-top: 1rem;">
    <a href="/stellar/journey#top" class="back-button" data-turbo="false">↑ New Calculation</a>
  </div>
<% end %>
